# filexchange configuration.
#
# Install to /etc/filexchange/filexchange.env, owned by root, mode 600:
# systemd reads it as root before dropping privileges, so the service user
# never needs access to the token.
#
# Never commit a real copy of this file.

# --- Authentication -------------------------------------------------------
# Shared secret the bot presents as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -base64 48
# Must match CC_FILESERVER_TOKEN on the bot machine. At least 32 characters.
FX_UPLOAD_TOKEN=

# --- Addressing -----------------------------------------------------------
# How the bot and your browser reach this machine. Download links are built
# from it, so it must be the address clients can actually resolve, including
# the port. Use https:// unless FX_ALLOW_INSECURE is on.
FX_PUBLIC_URL=https://203.0.113.5:8443

# Port to listen on. Above 1024, so the service needs no privileges.
FX_PORT=8443
# Interface to bind. 0.0.0.0 is every interface.
FX_HOST=0.0.0.0

# --- TLS ------------------------------------------------------------------
# Generate with ./fileserver/gen-cert.sh <this-machine-ip>
# Both files must be readable by the filexchange user.
FX_TLS_CERT=/etc/filexchange/certs/server.crt
FX_TLS_KEY=/etc/filexchange/certs/server.key

# Serve plain HTTP. Only sensible on a trusted private network; the server
# refuses to start without TLS unless this is set on purpose.
FX_ALLOW_INSECURE=false

# --- Storage --------------------------------------------------------------
# Must match ReadWritePaths= in the systemd unit.
FX_DATA_DIR=/var/lib/filexchange
# Refuse uploads larger than this. Default 2 GiB.
FX_MAX_UPLOAD_BYTES=2147483648
# Delete files this long after upload.
FX_RETENTION_HOURS=24
FX_SWEEP_INTERVAL_SECONDS=3600

# --- Logging --------------------------------------------------------------
FX_LOG_LEVEL=INFO
FX_LOG_JSON=false
