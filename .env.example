# chaptercut configuration. Copy to .env and fill in.
# Every value here is a placeholder. Never commit a real .env.

# --- Telegram bot ---------------------------------------------------------
# Token from @BotFather. Format: <digits>:<35 urlsafe chars>
CC_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Base URL of the Bot API server. Use the local telegram-bot-api container to
# lift the 50 MB upload limit to 2 GB. Set https://api.telegram.org to run
# against Telegram's cloud server instead (50 MB limit applies).
CC_BOT_API_URL=http://bot-api:8081

# Pass is_local=True to aiogram so files are handed to the server by path
# instead of being uploaded. Must be false when CC_BOT_API_URL is the cloud.
CC_BOT_API_LOCAL=true

# --- Authorization --------------------------------------------------------
# Comma-separated Telegram user IDs allowed to use the bot. Required.
CC_ALLOWED_USER_IDS=111111111,222222222
# Subset of the above allowed to run /cache purge and /cookies. Required.
CC_ADMIN_USER_IDS=111111111

# --- Storage --------------------------------------------------------------
# Runtime volume. Must be mounted at the same path in the bot and bot-api
# containers so file paths resolve identically on both sides.
CC_DATA_DIR=/data
# Netscape cookies.txt exported from a logged-in browser. Optional: if the
# file is missing yt-dlp runs without cookies. Treat as a password.
CC_COOKIES_FILE=/data/cookies.txt

# --- yt-dlp ---------------------------------------------------------------
# Extra CLI args appended to every yt-dlp invocation, shell-quoted.
# Example: --extractor-args "youtube:player_client=default,mweb"
CC_YTDLP_EXTRA_ARGS=

# --- Audio ----------------------------------------------------------------
# Empty means VBR at the best quality. Set e.g. 192K for constant bitrate.
CC_AUDIO_BITRATE=
# How multi-track results are delivered: zip | individual | both
CC_AUDIO_MULTI_DELIVERY=zip
# Center-crop non-square cover art to a square before embedding.
CC_COVER_SQUARE=true

# --- Limits ---------------------------------------------------------------
# Refuse to send files larger than this (local Bot API server caps at 2 GB).
CC_MAX_SEND_BYTES=1900000000
# Evict least-recently-served cache entries above this total size.
CC_CACHE_MAX_BYTES=21474836480
CC_WORKER_CONCURRENCY=1
CC_DOWNLOAD_TIMEOUT_SECONDS=1800
CC_SHUTDOWN_GRACE_SECONDS=120
CC_RATE_LIMIT_PER_MINUTE=20

# --- Logging --------------------------------------------------------------
CC_LOG_LEVEL=INFO
CC_LOG_JSON=false

# --- telegram-bot-api container (docker compose only) ---------------------
# From https://my.telegram.org, not from @BotFather.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
