# Everything in this repository is stored with LF, and checked out with LF on
# every platform. Without this, files authored on Windows land in the index
# with CRLF and then break on Linux: a shell script fails with "bad
# interpreter", and systemd's EnvironmentFile keeps the carriage return inside
# the value, so a token silently gains a trailing \r.
* text=auto eol=lf

# Spelled out for the files where the wrong ending is fatal rather than untidy.
*.sh        text eol=lf
*.service   text eol=lf
*.env       text eol=lf
.env.example text eol=lf
Dockerfile  text eol=lf
justfile    text eol=lf

# Never transform these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp3  binary
*.mp4  binary
*.zip  binary
*.db   binary
